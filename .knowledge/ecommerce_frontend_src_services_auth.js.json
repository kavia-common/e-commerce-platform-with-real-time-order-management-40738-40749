{"is_source_file": true, "format": "JavaScript", "description": "This file defines authentication-related utility functions for managing tokens in local storage, setting headers via setAuthToken, and installing an axios response interceptor to handle 401 unauthorized responses. It includes functions to get, store, clear, and check authentication tokens, as well as to handle token expiration and redirect users to login upon invalid tokens.", "external_files": ["./apiClient"], "external_methods": ["setAuthToken"], "published": ["getStoredToken", "storeToken", "clearToken", "isAuthenticated", "installAuthInterceptor"], "classes": [], "methods": [{"name": "getStoredToken()", "description": "Returns the authentication token stored in local storage, or null if not present.", "scope": "", "scopeKind": ""}, {"name": "storeToken(token)", "description": "Stores a given token string in local storage and updates the axios default authorization header.", "scope": "", "scopeKind": ""}, {"name": "clearToken()", "description": "Removes the authentication token from local storage and resets the axios authorization header.", "scope": "", "scopeKind": ""}, {"name": "isAuthenticated()", "description": "Checks whether a token is currently stored, indicating an authenticated user.", "scope": "", "scopeKind": ""}, {"name": "installAuthInterceptor(navigate)", "description": "Sets up an axios response interceptor that detects 401 responses, clears tokens, and redirects to the login page.", "scope": "", "scopeKind": ""}], "calls": ["localStorage.getItem", "localStorage.setItem", "localStorage.removeItem", "setAuthToken", "api.interceptors.response.use"], "search-terms": ["auth_token", "installAuthInterceptor", "setAuthToken", "localStorage", "axios 401 interceptor"], "state": 2, "file_id": 21, "knowledge_revision": 62, "git_revision": "d9ecdd5d54eba0b05e26adfcd44c7c3fafb132e8", "revision_history": [{"49": ""}, {"62": "d9ecdd5d54eba0b05e26adfcd44c7c3fafb132e8"}], "ctags": [{"_type": "tag", "n