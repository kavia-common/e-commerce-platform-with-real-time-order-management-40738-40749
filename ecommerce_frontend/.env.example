# Frontend environment variables

# Backend API base URL
# Ensure this points to the FastAPI backend port (default: 3001)
REACT_APP_BACKEND_URL=http://localhost:3001

# Optional: Supabase credentials for realtime features on Orders page
# If provided, Orders page will subscribe to realtime updates on 'orders' table.
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
