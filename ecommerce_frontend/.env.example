# Frontend environment variables for ecommerce_frontend

# Backend base URL (e.g., http://localhost:3001)
REACT_APP_BACKEND_URL=

# Optional Supabase configuration for realtime orders
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Public site URL for auth flows (if needed in future)
REACT_APP_SITE_URL=
